#!/bin/sh

set -e

# source grommunio set up shell library
. /usr/share/grommunio-pkg-bits/scripts/setup-grommunio-setup
# source debconf stuff
. /usr/share/debconf/confmodule
if ! register_templates grommunio-setup; then
        # deal with preconfigure ordering issues
        # defer to running config from postinst
        exit 0
fi

db_version 2.0
db_title "grommunio-setup" || true
# This conf script is capable of backing up
db_capb backup


