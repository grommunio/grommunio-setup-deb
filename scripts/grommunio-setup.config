#!/bin/bash

set -e

# source setup-grommunio-setup for some vars
. /usr/share/grommunio-pkg-bits/scripts/setup-grommunio-setup

# source debconf stuff
. /usr/share/debconf/confmodule

db_version 2.0
db_title "grommunio-setup" || true
# This conf script is capable of backing up
db_capb backup

STATE=1

while true; do
        case "$STATE" in
                1)
                        db_beginblock
                        db_subst grommunio-setup/setup-options-select selections \
                                "${OPTION_SELECTIONS}"
                        db_input high grommunio-setup/setup-options-select || true
                        db_endblock
                        ;;
                *)
                        # Detect if STATE greater than last implemented state
                        break
                        ;;
        esac
        if db_go; then
                STATE=$((STATE + 1))
        else
                STATE=$((STATE - 1))
        fi
done
if [ $STATE -eq 0 ]; then
        # user asked to backup from the first question
        exit 10
fi
exit 0

